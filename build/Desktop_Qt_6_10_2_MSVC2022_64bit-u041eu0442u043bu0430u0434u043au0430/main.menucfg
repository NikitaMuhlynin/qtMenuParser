{
  "id": "root",
  "title": "Main menu",
  "type": "menu",
  "children": [
    {
      "id": "settings",
      "title": "Settings",
      "type": "submenu",
      "children": [
        {
          "id": "display",
          "title": "Display",
          "type": "button",
          "parameters": [
            { "name": "Brightness", "type": "int", "default": 50, "min": 0, "max": 100 },
            { "name": "Fullscreen", "type": "bool", "default": true }
          ],
          "action": {
            "id": "apply_display",
            "command": "applyDisplay"
          }
        }
      ]
    },
    {
      "id": "about",
      "title": "About",
      "type": "button",
      "action": {
        "id": "show_about",
        "command": "showAbout"
      }
    }
  ]
}